# Salin sebagai .env.local lalu isi dari Supabase Dashboard → Project Settings → API
# URL: https://supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (email reminder) — jika menggunakan Resend
# RESEND_API_KEY=
# EMAIL_FROM=Pelacak Langganan <onboarding@resend.dev>

# Gmail SMTP (email reminder 100% gratis ke siapa saja tanpa custom domain)
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx (16-digit Google App Password)
